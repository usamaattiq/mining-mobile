EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Push notifications go through mining-api -> Ping. No client-side Firebase/
# APNs keys are needed here — Expo's push service (backed by Ping) handles
# both, using the credentials registered via `eas credentials`.

# Google Maps / Places — one key per platform.
# Never commit real keys. Set on EAS (Sensitive) for production / preview / development.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# Optional legacy fallback for local dev if you only have one key:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local .env is gitignored. `eas.json` does not embed Maps keys.

# Not used — the S3 bucket is private; media is fetched via short-lived
# presigned URLs from mining-api (see src/shared/services/media.ts).
# EXPO_PUBLIC_S3_PUBLIC_BASE_URL=
