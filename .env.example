# =============================================================================
# LOCAL DEVELOPMENT ONLY (expo start / Expo Go / simulator)
# Loaded from this file. Never put production URLs here.
# =============================================================================
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_S3_PUBLIC_BASE_URL=https://dahabi-sudan.s3.eu-north-1.amazonaws.com

# =============================================================================
# PRODUCTION / PREVIEW — set on EAS (not in this file)
# Dashboard → Project → Environment variables → production
#
#   EXPO_PUBLIC_API_URL=https://api.dahabi-sudan.com/api
#   EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=...
#   EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=...
#   EXPO_PUBLIC_S3_PUBLIC_BASE_URL=https://dahabi-sudan.s3.eu-north-1.amazonaws.com
#
# Builds/OTAs with --profile production|preview use those EAS values.
# Do not run `npm run env:push:production` while .env still has a LAN API URL.
# =============================================================================
