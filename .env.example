EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Push notifications go through mining-api -> Ping. No client-side Firebase/
# APNs keys are needed here — Expo's push service (backed by Ping) handles
# both, using the credentials registered via `eas credentials`.

# Google Maps (WebView JS + optional native config). Never commit real keys.
# Set on EAS (Sensitive) for production / preview / development.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local .env is gitignored. `eas.json` does not embed Maps keys.

# Must match mining-api's AWS_S3_PUBLIC_BASE_URL — the bucket is public-read
# and uploaded object keys resolve to URLs under this base (see media.ts).
EXPO_PUBLIC_S3_PUBLIC_BASE_URL=
