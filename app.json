{
  "expo": {
    "name": "Mining Mobile",
    "slug": "mining",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "scheme": "miningmobile",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.silveraxis.miningmobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Mining Mobile to use Face ID to sign you in quickly and securely."
      }
    },
    "android": {
      "package": "com.silveraxis.miningmobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#222222"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FCFBF8",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "owner": "mycauses-organization",
    "extra": {
      "eas": {
        "projectId": "6a8a7e38-8bcf-4186-91b8-6f503fdfb691"
      }
    },
    "plugins": ["expo-navigation-bar"]
  }
}
