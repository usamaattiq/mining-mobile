{
  "expo": {
    "name": "Dahabi",
    "slug": "mining",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "scheme": "miningmobile",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.silveraxis.mining",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Dahabi to use Face ID to sign you in quickly and securely."
      }
    },
    "android": {
      "package": "com.silveraxis.mining",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#222222"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FCFBF8",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6a8a7e38-8bcf-4186-91b8-6f503fdfb691",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "mycauses-organization",
    "extra": {
      "eas": {
        "projectId": "6a8a7e38-8bcf-4186-91b8-6f503fdfb691"
      }
    },
    "plugins": ["expo-navigation-bar", "react-native-edge-to-edge"]
  }
}
